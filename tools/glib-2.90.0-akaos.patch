 /* Common code {{{2 */
 #else
-#error No _g_get_unix_mounts() implementation for system
+static const char *
+get_mtab_monitor_file (void)
+{
+  return "/proc/mounts";
+}
+
+static gboolean
+akaos_mount_option_present (const char *options,
+                            const char *wanted)
+{
+  size_t wanted_length = strlen (wanted);
+  const char *cursor = options;
+
+  while (cursor && *cursor)
+    {
+      const char *end = strchr (cursor, ',');
+      size_t length = end ? (size_t) (end - cursor) : strlen (cursor);
+      if (length == wanted_length &&
+          memcmp (cursor, wanted, wanted_length) == 0)
+        return TRUE;
+      if (!end)
+        break;
+      cursor = end + 1;
+    }
+  return FALSE;
+}
+
+static size_t
+akaos_mount_fields (char *line,
+                   char **fields,
+                   size_t field_count)
+{
+  size_t count = 0;
+  char *cursor = line;
+
+  while (*cursor && count < field_count)
+    {
+      while (g_ascii_isspace (*cursor))
+        cursor++;
+      if (!*cursor || *cursor == '#')
+        break;
+      fields[count++] = cursor;
+      while (*cursor && !g_ascii_isspace (*cursor))
+        cursor++;
+      if (*cursor)
+        *cursor++ = '\0';
+    }
+  return count;
+}
+
+static GUnixMountEntry **
+_g_unix_mounts_get_from_file (const char *table_path,
+                              uint64_t   *time_read_out,
+                              size_t     *n_entries_out)
+{
+  const char *path = table_path ? table_path : "/proc/mounts";
+  FILE *file = g_fopen (path, "r");
+  GPtrArray *entries = g_ptr_array_new_with_free_func (
+      (GDestroyNotify) g_unix_mount_entry_free);
+  char line[1024];
+
+  if (time_read_out != NULL)
+    *time_read_out = get_mounts_timestamp ();
+  if (file != NULL)
+    {
+      while (fgets (line, sizeof (line), file) != NULL)
+        {
+          char *fields[6];
+          if (akaos_mount_fields (line, fields, G_N_ELEMENTS (fields)) < 4)
+            continue;
+          GUnixMountEntry *entry = create_unix_mount_entry (
+              fields[0], fields[1], NULL, fields[2], fields[3],
+              akaos_mount_option_present (fields[3], "ro"));
+          g_ptr_array_add (entries, entry);
+        }
+      fclose (file);
+    }
+
+  if (n_entries_out != NULL)
+    *n_entries_out = entries->len;
+  return (GUnixMountEntry **) g_ptr_array_free (entries, FALSE);
+}
+
+static GList *
+_g_get_unix_mounts (void)
+{
+  GUnixMountEntry **entries = NULL;
+  size_t n_entries = 0;
+  entries = _g_unix_mounts_get_from_file ("/proc/mounts", NULL,
+                                           &n_entries);
+  return unix_mount_entry_array_free_to_list (entries, n_entries);
+}
